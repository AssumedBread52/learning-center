#!/usr/bin/env bash
# Runs the checks before a commit (ADR-5) through scripts/check.sh, the
# list the hosted check shares (ADR-6), and refuses the commit when any
# failed.
set -uo pipefail

main() {
  cd "$(git rev-parse --show-toplevel)" || exit 1
  if ! bash scripts/check.sh; then
    echo 'pre-commit: refused' >&2
    exit 1
  fi
}

main "$@"
