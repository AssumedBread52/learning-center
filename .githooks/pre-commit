#!/usr/bin/env bash
# Runs every check in scripts/checks/ before a commit (ADR-5), all of them
# even after one fails, and refuses the commit when any failed.
set -uo pipefail

main() {
  cd "$(git rev-parse --show-toplevel)" || exit 1
  local check failed=()
  for check in scripts/checks/*.sh; do
    bash "$check" || failed+=("$check")
  done
  if [ "${#failed[@]}" -gt 0 ]; then
    echo "pre-commit: refused; failing checks: ${failed[*]}" >&2
    exit 1
  fi
}

main "$@"
